-- --- MAIN LOOP ---
renderConn = RunService.RenderStepped:Connect(function()
    if unloaded then return end
    for _, d in pairs(drawingsToClean) do pcall(function() d:Remove() end) end
    drawingsToClean = {};

    if options.Speed and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local rp = LocalPlayer.Character.HumanoidRootPart;
        local hum = LocalPlayer.Character:FindFirstChild("Humanoid");
        if hum and hum.MoveDirection.Magnitude > 0 then
            rp.CFrame = rp.CFrame + (hum.MoveDirection * options.SpeedVal);
        end
    end
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        local hum = LocalPlayer.Character.Humanoid;
        if options.Jump then hum.UseJumpPower = true; hum.JumpPower = options.JumpVal end
        if options.AutoStrafe and hum.MoveDirection.Magnitude > 0 then
            local rp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart");
            if rp then local vel = rp.Velocity; rp.Velocity = Vector3.new(vel.X*2, vel.Y, vel.Z*2) end
        end
    end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") and player.Character:FindFirstChild("HumanoidRootPart") then
            local char = player.Character; local head = char.Head; local root = char.HumanoidRootPart;
            local enemy = IsEnemy(player) and IsAlive(player)

            -- ESP BOX : uniquement adversaires (on nettoie les allies)
            if options.ESP_Box and enemy then
                local esp = char:FindFirstChild("PoloESP");
                if not esp then
                    esp = Instance.new("Highlight");
                    esp.Name = "PoloESP";
                    esp.FillColor = Color3.fromRGB(255,0,0);
                    esp.OutlineColor = Color3.fromRGB(255,255,255);
                    esp.FillTransparency = 0.5;
                    esp.OutlineTransparency = 0;
                    esp.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop;
                    esp.Adornee = char;
                    esp.Parent = char;
                else
                    esp.FillColor = Color3.fromRGB(255,0,0);
                    esp.Enabled = true;
                end
            else
                local e = char:FindFirstChild("PoloESP"); if e then e:Destroy() end
            end

            -- Si ce n'est pas un ennemi, on ne fait ni skeleton, ni tracer, ni distance, ni hitbox
            -- et on restaure sa tete au cas ou elle avait ete agrandie avant
            if not enemy then
                pcall(function()
                    if head.Size ~= Vector3.new(2,1,1) then
                        head.Size = Vector3.new(2,1,1); head.Transparency = 0; head.CanCollide = false
                    end
                end)
            else
                if options.ESP_Skeleton then
                    local function df(p1,p2)
                        if p1 and p2 then
                            local s1,o1 = Camera:WorldToViewportPoint(p1.Position);
                            local s2,o2 = Camera:WorldToViewportPoint(p2.Position);
                            if o1 and o2 then table.insert(drawingsToClean, createLine(Vector2.new(s1.X,s1.Y), Vector2.new(s2.X,s2.Y), Color3.fromRGB(255,0,0))) end
                        end
                    end
                    local up = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso");
                    local low = char:FindFirstChild("LowerTorso");
                    df(head, up); df(up, low);
                end

                if options.ESP_Line then
                    local rs, onR = Camera:WorldToViewportPoint(root.Position);
                    if onR then table.insert(drawingsToClean, createLine(Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y), Vector2.new(rs.X, rs.Y), Color3.fromRGB(255,0,0))) end
                end

                if options.ESP_Distance then
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        local hs, onH = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,1,0));
                        if onH then
                            local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude);
                            table.insert(drawingsToClean, createText(Vector2.new(hs.X, hs.Y), tostring(dist).."m", Color3.fromRGB(255,255,255)));
                        end
                    end
                end

                if options.Hitbox then
                    head.Size = Vector3.new(options.HitboxSize, options.HitboxSize, options.HitboxSize);
                    head.Transparency = 0.5; head.CanCollide = false;
                else
                    -- restaure si Hitbox OFF mais tete encore agrandie
                    if head.Transparency == 0.5 then
                        head.Size = Vector3.new(2,1,1); head.Transparency = 0; head.CanCollide = false
                    end
                end
            end
        end
    end

    if options.Aimbot and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        -- Ne pas aim quand on tape dans un champ (whitelist) ou menu texte focus
        local typing = false
        pcall(function() typing = UserInputService:GetFocusedTextBox() ~= nil end)
        if not typing then
            local target = getBestTarget();
            if target and target.Character and target.Character:FindFirstChild("Head") and type(mousemoverel)=="function" then
                local sp, onS = Camera:WorldToViewportPoint(target.Character.Head.Position);
                if onS then local mp = UserInputService:GetMouseLocation(); pcall(function() mousemoverel((sp.X-mp.X)/options.AimbotSmooth, (sp.Y-mp.Y)/options.AimbotSmooth) end) end
            end
        end
    end
    if options.TriggerBot then
        local typing2 = false
        pcall(function() typing2 = UserInputService:GetFocusedTextBox() ~= nil end)
        -- Par defaut le trigger ne tire que sur clic-droit pour laisser cliquer le menu librement
        local rmbOk = true
        if options.TriggerOnRMB then
            rmbOk = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        end
        if not typing2 and rmbOk and (os.clock() - triggerLastShot) >= (options.TriggerDelay or 0.25) then
            local t = Mouse.Target;
            if t and t.Parent and type(mouse1click)=="function" then
                pcall(function()
                    local model = t:FindFirstAncestorOfClass("Model")
                    if model then
                        local plr = Players:GetPlayerFromCharacter(model)
                        -- ne tire auto que si c'est un adversaire vivant
                        if plr and plr ~= LocalPlayer and IsEnemy(plr) and IsAlive(plr) then
                            triggerLastShot = os.clock()
                            mouse1click()
                        end
                    end
                end)
            end
        end
    end
    if options.NoRecoil or options.NoSpread or options.FastReload then applyWeaponMods() end
end);

