-- --- DRAW UTILS ---
local function createLine(pos1, pos2, color)
    local line = Drawing.new("Line");
    line.Visible = true; line.Thickness = 1;
    line.Color = color or Color3.fromRGB(255,0,0);
    line.From = pos1; line.To = pos2;
    return line;
end
local function createText(pos, text, color)
    local t = Drawing.new("Text");
    t.Visible = true; t.Center = true; t.Outline = true;
    t.Size = 14; t.Color = color or Color3.fromRGB(255,255,255);
    t.Position = pos; t.Text = text;
    return t;
end

-- ===== FIX TEAM CHECK : adversaires uniquement =====
-- Sniper Arena officiel = FFA (pas de Teams). Donc "teammate" = ami / whitelist.
-- On check dans l'ordre : soi-meme > whitelist > amis > Team Roblox > Teams custom > FFA
local function GetWhitelist()
    local t = {}
    if options.WhitelistNames and options.WhitelistNames ~= "" then
        for name in string.gmatch(options.WhitelistNames, "([^,;]+)") do
            name = name:gsub("^%s+", ""):gsub("%s+$", ""):lower()
            if name ~= "" then t[name] = true end
        end
    end
    return t
end

local function IsWhitelisted(player)
    local wl = GetWhitelist()
    if wl[player.Name:lower()] then return true end
    if wl[player.DisplayName:lower()] then return true end
    return false
end

local function IsFriend(player)
    local ok, res = pcall(function()
        return LocalPlayer:IsFriendsWith(player.UserId)
    end)
    if ok then return res end
    return false
end

local function GetCustomTeam(player)
    -- Check tous les endroits ou Sniper Arena / jeux customs stockent l'equipe
    local candidates = {"Team", "Side", "Faction", "Squad", "Group", "Equipe", "Camp"}
    for _, attr in ipairs(candidates) do
        local ok, val = pcall(function() return player:GetAttribute(attr) end)
        if ok and val ~= nil then return tostring(val) end
        ok, val = pcall(function()
            if player.Character then return player.Character:GetAttribute(attr) end
            return nil
        end)
        if ok and val ~= nil then return tostring(val) end
        ok, val = pcall(function()
            local v = player:FindFirstChild(attr) or (player.Character and player.Character:FindFirstChild(attr))
            if v and (v:IsA("StringValue") or v:IsA("IntValue") or v:IsA("ObjectValue")) then
                return v.Value
            end
            return nil
        end)
        if ok and val ~= nil then return tostring(val) end
        ok, val = pcall(function()
            local ls = player:FindFirstChild("leaderstats")
            if ls then
                local v = ls:FindFirstChild(attr)
                if v then return v.Value end
            end
            return nil
        end)
        if ok and val ~= nil then return tostring(val) end
    end
    return nil
end

local function IsEnemy(player)
    if player == LocalPlayer then return false end
    -- 0) Whitelist / Amis TOUJOURS exclus, meme si TeamCheck OFF
    if IsWhitelisted(player) then return false end
    if options.IgnoreFriends and IsFriend(player) then return false end
    if not options.TeamCheck then return true end

    -- 1) Check standard Roblox Team
    local ok, res = pcall(function()
        if LocalPlayer.Team ~= nil and player.Team ~= nil then
            return LocalPlayer.Team ~= player.Team
        end
        return nil
    end)
    if ok and res ~= nil then return res end

    -- 2) TeamColor (seulement si les 2 ont une vraie equipe, pas Neutral)
    local ok2, res2 = pcall(function()
        if LocalPlayer.TeamColor and player.TeamColor then
            if LocalPlayer.Neutral or player.Neutral then return nil end -- FFA, on passe au custom
            return LocalPlayer.TeamColor ~= player.TeamColor
        end
        return nil
    end)
    if ok2 and res2 ~= nil then return res2 end

    -- 3) Teams customs (attributs / StringValue / leaderstats)
    local lt = GetCustomTeam(LocalPlayer)
    local pt = GetCustomTeam(player)
    if lt ~= nil and pt ~= nil then return lt ~= pt end

    -- 4) Fallback FFA : tout le monde est ennemi SAUF amis/whitelist (deja filtres)
    return true
end

