        or workspace:FindFirstChild("SuitsButtons")
end

local function GetBestSuit(trophies)
    local folder = GetSuitsFolder()
    if not folder then return nil end
    local best = nil
    for _, child in ipairs(folder:GetChildren()) do
        if child:IsA("Model") then
            local placement = child:GetAttribute("SuitPlacement")
            if type(placement) ~= "number" then
                placement = tonumber(string.match(child.Name, "^SuiteButton(%d+)$"))
            end
            if type(placement) == "number" and placement >= 1 and placement <= 30 then
                local cost = tonumber(child:GetAttribute("SuitTrophyCost"))
                if cost == nil then
                    cost = (placement == 1) and 0 or nil
                end
                if cost ~= nil and cost <= trophies then
                    if not best or placement > best.placement then
                        local touchPart = child:FindFirstChild("TouchPart", true)
                        if touchPart and touchPart:IsA("BasePart") then
                            best = {
                                placement = placement,
                                button = child,
                                touchPart = touchPart,
                                cost = cost,
                                name = child:GetAttribute("SuitName") or child.Name,
                            }
                        end
                    end
                end
            end
        end
    end
    return best
end

local function FireSuitTouch(touchPart)
    if typeof(firetouchinterest) ~= "function" then
        Rayfield:Notify({ Title = "Executor Not Supported", Content = "firetouchinterest() is missing", Duration = 4 })
        return false
    end
    local char = LocalPlayer.Character
    local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head"))
    if not hrp then return false end
    pcall(function()
        firetouchinterest(hrp, touchPart, 0)
        task.wait(0.1)
        firetouchinterest(hrp, touchPart, 1)
    end)
    return true
end

local function GetEquippedPlacement()
    local raw = nil
    pcall(function()
        raw = LocalPlayer:GetAttribute("EquippedSuit")
        if raw == nil then raw = LocalPlayer:GetAttribute("AppliedSuit") end
    end)
    if raw == nil then return nil end
    if tonumber(raw) then return math.floor(tonumber(raw)) end
    local folder = GetSuitsFolder()
    if not folder then return nil end
    local function norm(s)
        s = string.lower(tostring(s))
        if s == "anti ock" or s == "anti-ock" then return "ock spider" end
        if s == "cosmic" then return "cosmic" end
        return s
    end
    local target = norm(raw)
    for _, child in ipairs(folder:GetChildren()) do
        if child:IsA("Model") then
            local placement = child:GetAttribute("SuitPlacement")
            if type(placement) ~= "number" then
                placement = tonumber(string.match(child.Name, "^SuiteButton(%d+)$"))
            end
            if type(placement) == "number" then
                local nm = child:GetAttribute("SuitName") or child.Name
                if norm(nm) == target or string.lower(child.Name) == target then
                    return placement
                end
            end
        end
    end
    return nil
end

local function TryUpgradeSuit(manual)
    local trophies = GetTrophies()
    if trophies == nil then
        if manual then Rayfield:Notify({ Title = "Suits", Content = "Trophies attribute not found", Duration = 3 }) end
        return
    end
    local best = GetBestSuit(trophies)
    if not best then
        if manual then Rayfield:Notify({ Title = "Suits", Content = "Nothing affordable yet", Duration = 3 }) end
        return
    end
    local equipped = GetEquippedPlacement()
    if equipped == best.placement then
        local changed = (_G.LastSuitPlacement ~= equipped)
        _G.LastSuitPlacement = equipped
        if manual or changed then
            Rayfield:Notify({ Title = "Suit Equipped", Content = "N" .. best.placement .. " " .. tostring(best.name), Duration = 3 })
        end
        return
    end
    FireSuitTouch(best.touchPart)
    task.wait(0.3)
    FireSuitTouch(best.touchPart)
    if manual then
        Rayfield:Notify({ Title = "Suits", Content = "Equipping N" .. best.placement .. " " .. tostring(best.name) .. "...", Duration = 3 })
    end
end

