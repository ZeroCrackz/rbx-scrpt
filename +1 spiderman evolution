local function TeleportToCF(cf)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        SetTPStatus("Failed: no character")
        return false
    end
    local dest = cf + Vector3.new(3, 3, 0)
    SetTPStatus("Going to " .. tostring(dest.Position))
    task.spawn(function()
        _G.TPNoclip = true
        task.spawn(function()
            local start = os.clock()
            while os.clock() - start < 6 and Session == _G.ScriptGen do
                pcall(function()
                    local c = LocalPlayer.Character
                    if c then
                        for _, p in ipairs(c:GetDescendants()) do
                            if p:IsA("BasePart") then
                                p.CanCollide = false
                                p.Anchored = false
                            end
                        end
                        local hum = c:FindFirstChildOfClass("Humanoid")
                        if hum then hum.Sit = false end
                    end
                end)
                task.wait(0.1)
            end
            _G.TPNoclip = false
            pcall(function()
                local c = LocalPlayer.Character
                if c then
                    local hum = c:FindFirstChildOfClass("Humanoid")
                    if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
                end
            end)
        end)
        local startPos = hrp.Position
        local dist = (dest.Position - startPos).Magnitude
        local steps = math.clamp(math.ceil(dist / 250), 1, 12)
        SetTPStatus(math.floor(dist) .. " studs, " .. steps .. " steps...")
        for i = 1, steps do
            if _G.KillAuraUnloaded or Session ~= _G.ScriptGen then
                SetTPStatus("Cancelled")
                break
            end
            local c = LocalPlayer.Character
            local h = c and c:FindFirstChild("HumanoidRootPart")
            if not h then SetTPStatus("Character lost, stopped") break end
            if i < steps then
                local mid = startPos:Lerp(dest.Position, i / steps) + Vector3.new(0, 40, 0)
                pcall(function() c:PivotTo(CFrame.new(mid)) end)
                SetTPStatus("Step " .. i .. "/" .. steps)
                task.wait(0.35)
            else
                pcall(function() c:PivotTo(dest) end)
                pcall(function() h.CFrame = dest end)
            end
        end
        task.wait(0.4)
        Unfreeze()
        task.wait(0.5)
        pcall(function()
            local c2 = LocalPlayer.Character
            local h2 = c2 and c2:FindFirstChild("HumanoidRootPart")
            if not h2 then SetTPStatus("Cannot verify (no character)") return end
            local d = (h2.Position - dest.Position).Magnitude
            SetTPStatus("Arrival distance: " .. math.floor(d) .. " studs")
            if d > 20 then
                SetTPStatus("Missed, retrying...")
                pcall(function() c2:PivotTo(dest) end)
                pcall(function() h2.CFrame = dest end)
                Unfreeze()
                task.wait(0.5)
                local d2 = (h2.Position - dest.Position).Magnitude
                SetTPStatus("After retry: " .. math.floor(d2) .. " studs")
                if d2 > 20 then
                    Rayfield:Notify({ Title = "Teleport Blocked", Content = "The game is pulling you back", Duration = 5 })
                else
                    Rayfield:Notify({ Title = "Teleported", Content = "Arrived at " .. tostring(_G.WinStage or "Win"), Duration = 3 })
                end
            else
                Rayfield:Notify({ Title = "Teleported", Content = "Arrived at " .. tostring(_G.WinStage or "Win"), Duration = 3 })
            end
        end)
    end)
    return true
end

local function TeleportToWin()
    local folder, stageName = GetLatestStage()
    if folder then
        local btn = FindStageWinButton(folder)
        if btn then
            local cf = GetModelPivot(btn)
            if cf then
                _G.WinCFrame = cf
                _G.WinStage = stageName
                TeleportToCF(cf)
                Rayfield:Notify({ Title = "Teleporting...", Content = "Heading to " .. tostring(stageName) .. " (auto)", Duration = 3 })
                return
            end
        end
    end
    if _G.WinCFrame then
        TeleportToCF(_G.WinCFrame)
        Rayfield:Notify({ Title = "Teleporting...", Content = "Heading to " .. tostring(_G.WinStage or "Win") .. " (cached)", Duration = 3 })
        return
    end
    TeleportToCF(WIN_CFRAME)
    _G.WinCFrame = WIN_CFRAME
    Rayfield:Notify({ Title = "Teleporting...", Content = "Heading to Win (fallback)", Duration = 3 })
end

