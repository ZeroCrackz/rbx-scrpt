    Flag = "AutoloadSetup",
    Callback = function(Value)
        _G.AutoloadSetup = Value
        if not HasFS() then
            Rayfield:Notify({ Title = "No File Access", Content = "Autoload needs writefile/readfile", Duration = 4 })
            return
        end
        pcall(function()
            if Value then
                writefile(AUTOLOAD_FILE, PresetName)
                Rayfield:Notify({ Title = "Autoload Enabled", Content = "Preset '" .. tostring(PresetName) .. "' will load on execute", Duration = 3 })
            else
                if typeof(delfile) == "function" then
                    if isfile(AUTOLOAD_FILE) then delfile(AUTOLOAD_FILE) end
                else
                    writefile(AUTOLOAD_FILE, "")
                end
                Rayfield:Notify({ Title = "Autoload Disabled", Content = "Stopped", Duration = 2 })
            end
        end)
    end,
})

local function RefreshEnemyCache()
    local char = LocalPlayer.Character
    local list = {}
    pcall(function()
        for _, model in ipairs(workspace:GetDescendants()) do
            if model:IsA("Model") and model ~= char and not Players:GetPlayerFromCharacter(model) then
                local hum = model:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and not model:FindFirstChildOfClass("ForceField") then
                    local root = model:FindFirstChild("HumanoidRootPart")
                        or model:FindFirstChild("Head")
                        or model.PrimaryPart
                    if root then
                        table.insert(list, {hum = hum, root = root})
                    end
                end
            end
        end
    end)
    _G.EnemyCache = list
    _G.EnemyCacheTime = os.clock()
end

task.spawn(function()
    while not _G.KillAuraUnloaded and Session == _G.ScriptGen do
        task.wait(_G.KillAuraDelay)
        if _G.KillAura then
            if os.clock() - (_G.EnemyCacheTime or 0) > 1.0 then
                RefreshEnemyCache()
            end
            pcall(function()
                local char = LocalPlayer.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                local hrpPos = hrp.Position
                local range = _G.KillAuraRange
                local dmg = _G.KillAuraDamage
                local hits = _G.KillAuraHits or 1
                local instant = _G.InstantKill
                for _, e in ipairs(_G.EnemyCache) do
                    local hum, root = e.hum, e.root
                    if hum.Parent and root.Parent and hum.Health > 0 then
                        if (hrpPos - root.Position).Magnitude <= range then
                            pcall(function()
                                if instant then
                                    hum.Health = 0
                                else
                                    for i = 1, hits do
                                        hum:TakeDamage(dmg)
                                        if hum.Health <= 0 then break end
                                    end
                                end
                            end)
                        end
                    end
                end
            end)
        else
            task.wait(0.5)
        end
    end
end)

task.spawn(function()
    local remote = GetMagicRemote()
    while not _G.KillAuraUnloaded and Session == _G.ScriptGen do
        if _G.AutoMagic then
            if not remote then remote = GetMagicRemote() end
            if remote then
                pcall(function()
                    remote:FireServer()
                end)
                task.wait(0.05)
            else
                task.wait(1)
            end
        else
            task.wait(0.2)
        end
    end
end)

task.spawn(function()
    local lastInfo = 0
    while not _G.KillAuraUnloaded and Session == _G.ScriptGen do
        if _G.AutoRebirth then
            local ok = pcall(function()
                local rb = GetRebirths()
                local lv = GetLevel()
                if rb == nil or lv == nil then return end
                local req = GetRequiredLevel(rb)
                if req == nil then
                    _G.RebirthMaxWarned = true
                    return
                end
                _G.RebirthMaxWarned = false
                if _G.RebirthNotify and os.clock() - lastInfo > 10 then
                    lastInfo = os.clock()
                    Rayfield:Notify({ Title = "Rebirth", Content = "Level " .. lv .. " / " .. req .. " (rebirths=" .. rb .. ")", Duration = 3 })
                end
                if lv >= req and os.clock() - (_G.RebirthCooldown or 0) > 3 then
                    local remote = GetRebirthRemote()
                    if remote then
                        _G.RebirthCooldown = os.clock()
                        remote:FireServer()
                        Rayfield:Notify({ Title = "REBIRTH!", Content = "Level " .. lv .. " reached, rebirth " .. (rb + 1), Duration = 4 })
                    end
                end
            end)
            task.wait(0.5)
        else
            task.wait(1)
        end
    end
end)

