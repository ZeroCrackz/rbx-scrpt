local function GetLatestStage()
    local stages = workspace:FindFirstChild("Stages")
    if not stages then return nil, nil end
    local maxN = nil
    for _, child in ipairs(stages:GetChildren()) do
        local n = tonumber(string.match(child.Name, "^Stage(%d+)$"))
        if n and (not maxN or n > maxN) then maxN = n end
    end
    if not maxN then return nil, nil end
    local folder = stages:FindFirstChild("Stage" .. (maxN - 1)) or stages:FindFirstChild("Stage" .. maxN)
    if not folder then return nil, nil end
    return folder, folder.Name
end

local function FindStageWinButton(folder)
    if not folder then return nil end
    local direct = folder:FindFirstChild("WinButton")
    if direct then return direct end
    return folder:FindFirstChild("WinButton", true)
end

local function GetModelPivot(target)
    if target:IsA("BasePart") then
        return target.CFrame
    elseif target:IsA("Model") then
        local ok, cf = pcall(function() return target.WorldPivot end)
        if ok and cf and cf.Position.Magnitude > 1 then return cf end
        if target.PrimaryPart then return target.PrimaryPart.CFrame end
        local part = target:FindFirstChildWhichIsA("BasePart", true)
        if part then return part.CFrame end
        local ok2, cf2 = pcall(function() return target:GetBoundingBox() end)
        if ok2 and cf2 then return cf2 end
    end
    return nil
end

local function Unfreeze()
    pcall(function()
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp then
            hrp.Anchored = false
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
        if hum then
            hum.Sit = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end)
end

