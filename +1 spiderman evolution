local PresetName = "default"
local AUTOLOAD_FILE = "KromaHub_autoload.txt"

local function PresetFile(name)
    return "KromaHub_" .. tostring(name) .. ".json"
end

local function HasFS()
    return typeof(writefile) == "function"
        and typeof(readfile) == "function"
        and typeof(isfile) == "function"
end

local function CollectSetup()
    return {
        KillAura = _G.KillAura and true or false,
        Range = _G.KillAuraRange,
        DamageM = math.clamp(math.floor((_G.KillAuraDamage or 0) / 1000000 + 0.5), 1, 10000),
        DelayCs = math.clamp(math.floor((_G.KillAuraDelay or 0.05) * 100 + 0.5), 1, 50),
        Hits = _G.KillAuraHits,
        Instant = _G.InstantKill and true or false,
        Magic = _G.AutoMagic and true or false,
        Rebirth = _G.AutoRebirth and true or false,
        RebirthInfo = _G.RebirthNotify and true or false,
        Suits = _G.AutoSuits and true or false,
    }
end

local function ApplySetup(data)
    if type(data) ~= "table" then return false end
    local applied = false
    local muted = Rayfield.Notify
    Rayfield.Notify = function() end
    pcall(function()
        local function setToggle(flag, v)
            local el = Rayfield.Flags and Rayfield.Flags[flag]
            if el then el:Set(v and true or false) end
        end
        local function setSlider(flag, v)
            local el = Rayfield.Flags and Rayfield.Flags[flag]
            if el and type(v) == "number" then el:Set(v) end
        end
        if data.Range then setSlider("KillAuraRange", data.Range) end
        if data.DamageM then setSlider("KillAuraDamageM", data.DamageM) end
        if data.DelayCs then setSlider("KillAuraDelay", data.DelayCs) end
        if data.Hits then setSlider("KillAuraHits", data.Hits) end
        setToggle("KillAuraToggle", data.KillAura)
        setToggle("InstantKill", data.Instant)
        setToggle("AutoMagic", data.Magic)
        setToggle("AutoRebirth", data.Rebirth)
        setToggle("RebirthNotify", data.RebirthInfo)
        setToggle("AutoSuits", data.Suits)
        applied = true
    end)
    Rayfield.Notify = muted
    return applied
end

local function LoadPreset(name)
    if not HasFS() then
        Rayfield:Notify({ Title = "No File Access", Content = "Your executor has no writefile/readfile", Duration = 4 })
        return false
    end
    local ok, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(readfile(PresetFile(name)))
    end)
    if not ok or type(data) ~= "table" then
        Rayfield:Notify({ Title = "Preset Not Found", Content = "No saved setup named '" .. tostring(name) .. "'", Duration = 4 })
        return false
    end
    task.wait(0.5)
    if ApplySetup(data) then
        Rayfield:Notify({ Title = "Setup Loaded", Content = "Preset: " .. tostring(name), Duration = 4 })
        return true
    end
    return false
end

