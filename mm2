local function nline()
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.BorderSizePixel = 0
	f.BackgroundColor3 = Color3.fromRGB(235, 235, 238)
	f.ZIndex = 999
	f.Visible = false
	f.Parent = overlay
	return f
end
local function dline(f, x1, y1, x2, y2, c)
	local dx = x2 - x1
	local dy = y2 - y1
	local len = math.sqrt(dx * dx + dy * dy)
	if len < 2 then f.Visible = false return end
	f.Visible = true
	f.BackgroundColor3 = c
	f.ZIndex = 999
	f.Size = UDim2.new(0, len, 0, CONFIG.ESPThickness)
	f.Position = UDim2.new(0, (x1 + x2) / 2, 0, (y1 + y2) / 2)
	f.Rotation = math.deg(math.atan2(dy, dx))
end
local function getESP(plr)
	local o = espCache[plr]
	if o then return o end
	local box = Instance.new("Frame")
	box.AnchorPoint = Vector2.new(0, 0)
	box.BackgroundTransparency = 1
	box.BorderSizePixel = 0
	box.ZIndex = 999
	box.Visible = false
	box.Parent = overlay
	local st = Instance.new("UIStroke", box)
	st.Thickness = 2
	st.Transparency = 0
	local nm = Instance.new("TextLabel")
	nm.BackgroundTransparency = 1
	nm.Font = Enum.Font.GothamBold
	nm.TextSize = 14
	nm.TextStrokeTransparency = 0
	nm.TextStrokeColor3 = Color3.new(0, 0, 0)
	nm.ZIndex = 999
	nm.Visible = false
	nm.Parent = overlay
	local tr = nline()
	local sk = {}
	for i = 1, #SKEL do sk[i] = nline() end
	local ar = Instance.new("TextLabel")
	ar.AnchorPoint = Vector2.new(0.5, 0.5)
	ar.BackgroundTransparency = 1
	ar.Font = Enum.Font.GothamBlack
	ar.TextSize = 22
	ar.Text = ">"
	ar.Size = UDim2.new(0, 30, 0, 30)
	ar.TextStrokeTransparency = 0
	ar.TextStrokeColor3 = Color3.new(0, 0, 0)
	ar.ZIndex = 999
	ar.Visible = false
	ar.Parent = overlay
	o = { box = box, st = st, name = nm, tracer = tr, skel = sk, arrow = ar, char = nil, P = {} }
	espCache[plr] = o
	return o
end
local function espParts(plr, ch)
	local o = espCache[plr]
	if not o then return {} end
	local need = (o.char ~= ch)
	if not need and ch then
		if o.P.HRP == nil or o.P.Head == nil or o.P.Hum == nil then
			need = true
		elseif o.P.HRP.Parent == nil or o.P.Head.Parent == nil then
			need = true
		end
	end
	if need then
		o.char = ch
		o.P = {}
		if ch then
			for _, d in ipairs(ch:GetDescendants()) do
				if d:IsA("BasePart") and o.P[d.Name] == nil then o.P[d.Name] = d end
			end
			o.P.HRP = ch:FindFirstChild("HumanoidRootPart")
			o.P.Head = ch:FindFirstChild("Head")
			o.P.Hum = ch:FindFirstChildOfClass("Humanoid")
		end
	end
	return o.P
end
local function hideESP(o)
	o.box.Visible = false o.name.Visible = false o.tracer.Visible = false o.arrow.Visible = false
	for _, f in ipairs(o.skel) do f.Visible = false end
end
