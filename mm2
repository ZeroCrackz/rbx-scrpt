local function sliderRow(parent, txt, minV, maxV, defV, fmt, cb, order, regKey)
	local wrap = Instance.new("Frame")
	wrap.Size = UDim2.new(1, 0, 0, 34)
	wrap.BackgroundTransparency = 1
	wrap.LayoutOrder = order or 1
	wrap.Parent = parent
	local top = Instance.new("Frame")
	top.Size = UDim2.new(1, 0, 0, 16)
	top.BackgroundTransparency = 1
	top.Parent = wrap
	local a = Instance.new("TextLabel")
	a.Size = UDim2.new(0.6, 0, 1, 0)
	a.BackgroundTransparency = 1
	a.Font = Enum.Font.GothamBold
	a.TextSize = 12
	a.TextXAlignment = Enum.TextXAlignment.Left
	a.TextColor3 = T.Txt
	a.Text = txt
	a.Parent = top
	local b = Instance.new("TextBox")
	b.Size = UDim2.new(0.4, 0, 1, 0)
	b.Position = UDim2.new(0.6, 0, 0, 0)
	b.BackgroundTransparency = 1
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 11
	b.TextXAlignment = Enum.TextXAlignment.Right
	b.TextColor3 = T.Txt
	b.ClearTextOnFocus = true
	b.TextEditable = true
	b.Parent = top
	local bar = Instance.new("TextButton")
	bar.Size = UDim2.new(1, -4, 0, 5)
	bar.Position = UDim2.new(0, 2, 0, 22)
	bar.BackgroundColor3 = T.Bar
	bar.Text = ""
	bar.AutoButtonColor = false
	bar.Parent = wrap
	corner(bar, 2)
	pcall(function() bar:SetAttribute("NoFX", true) end)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(200, 200, 205)
	fill.BorderSizePixel = 0
	fill.Parent = bar
	corner(fill, 2)
	local curV = defV
	local function isIntFmt()
		return fmt == "%d" or fmt == "%d ms" or fmt == "%d%%" or fmt == "%d HP" or fmt == "%d st" or fmt == "%d px"
	end
	local function show(v)
		curV = v
		if b:IsFocused() then return end
		b.Text = string.format(fmt, v)
	end
	local function setVal(v)
		v = math.clamp(v, minV, maxV)
		if isIntFmt() then v = math.floor(v + 0.5) end
		show(v)
		local p = (v - minV) / math.max(1e-6, maxV - minV)
		fill.Size = UDim2.new(math.clamp(p, 0, 1), 0, 1, 0)
		if cb then cb(v) end
	end
	local function apply(p)
		p = math.clamp(p, 0, 1)
		setVal(minV + p * (maxV - minV))
	end
	b.FocusLost:Connect(function()
		local num = tonumber(string.match(b.Text or "", "[%d%.%-]+"))
		if num then setVal(num) else show(curV) end
	end)
	local function fromX(x)
		if bar.AbsoluteSize.X <= 0 then return end
		apply((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X)
	end
	local drag = false
	bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = true fromX(i.Position.X) end end)
	UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then drag = false end end)
	UIS.InputChanged:Connect(function(i) if drag and i.UserInputType == Enum.UserInputType.MouseMovement then fromX(i.Position.X) end end)
	local p0 = (defV - minV) / math.max(1, maxV - minV)
	show(defV)
	fill.Size = UDim2.new(math.clamp(p0, 0, 1), 0, 1, 0)
	local api = { Set = function(v) setVal(v) end }
	if regKey then SliderReg[regKey] = function(v) setVal(v) end end
	return api
end

