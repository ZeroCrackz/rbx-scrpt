	b.Position = UDim2.new(1, -58, 0, 0)
	b.BackgroundColor3 = T.Box
	b.Font = Enum.Font.GothamBold
	b.TextSize = 11
	b.TextColor3 = T.Txt
	b.Text = "[ " .. cur.Name .. " ]"
	b.Parent = r
	corner(b, 3)
	local waiting = false
	b.MouseButton1Click:Connect(function()
		waiting = true
		b.Text = "[ ... ]"
	end)
	track(UIS.InputBegan:Connect(function(i)
		if waiting then
			if typing() then return end
			if i.KeyCode ~= Enum.KeyCode.Unknown then
				waiting = false
				b.Text = "[ " .. i.KeyCode.Name .. " ]"
				if cb then cb(i.KeyCode) end
			end
		end
	end))
	return b
end

