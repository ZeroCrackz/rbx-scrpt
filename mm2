	label(inf, "auto, hits players", 11, T.Dim, 3, false)
	label(inf, "within range.", 11, T.Dim, 4, false)

	local function isKnifeTool(t)
		if not (t and t:IsA("Tool")) then return false end
		local n = string.lower(t.Name)
		return n == "knife" or n == "blade" or string.find(n, "knife", 1, true) ~= nil
	end

	findKnife = function()
		local c = player.Character
		if c then
			for _, t in ipairs(c:GetChildren()) do
				if isKnifeTool(t) then return t end
			end
		end
		local bp = player:FindFirstChild("Backpack")
		if bp then
			for _, t in ipairs(bp:GetChildren()) do
				if isKnifeTool(t) then return t end
			end
		end
		return nil
	end

	isMurder = function()
		if mm2RoleKey(player) == "murder" then return true end
		return findKnife() ~= nil
	end

	local function knifeParts(knife)
		local parts = {}
		if knife then
			for _, d in ipairs(knife:GetDescendants()) do
				if d:IsA("BasePart") then table.insert(parts, d) end
			end
		end
		return parts
	end

	local function targetParts(ch)
		local parts = {}
		if ch then
			for _, n in ipairs({ "HumanoidRootPart", "Head", "UpperTorso", "Torso", "LowerTorso" }) do
				local p = ch:FindFirstChild(n)
				if p and p:IsA("BasePart") then table.insert(parts, p) end
			end
		end
		return parts
	end

	local function knifeHit(knife, ch)
		pcall(function() knife:Activate() end)
		local kp = knifeParts(knife)
		local tp = targetParts(ch)
		if #kp == 0 or #tp == 0 then return false end
		for _, a in ipairs(kp) do
			for _, b in ipairs(tp) do
				pcall(firetouchinterest, a, b, 0)
				task.wait()
				pcall(firetouchinterest, a, b, 1)
			end
		end
		return true
	end

	local function tpKnifeKill(targetCh)
		local _, myHRP, hum = getChar()
		local thrp = targetCh and targetCh:FindFirstChild("HumanoidRootPart")
		if not (myHRP and thrp) then return false end
		if targetCh:FindFirstChildOfClass("ForceField") then return false end
		local knife = findKnife()
		if knife and hum and knife.Parent ~= player.Character then
			pcall(function() hum:EquipTool(knife) end)
			task.wait(0.15)
			knife = findKnife()
		end
		myHRP.CFrame = thrp.CFrame * CFrame.new(0, 0, 2.5)
		myHRP.AssemblyLinearVelocity = Vector3.zero
		myHRP.AssemblyAngularVelocity = Vector3.zero
		if knife then
			pcall(function() knife:Activate() end)
			knifeHit(knife, targetCh)
		end
		task.wait(0.15)
		return true
	end

	countAlive = function()
		local n = 0
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character then
				local hu = p.Character:FindFirstChildOfClass("Humanoid")
				if hu and hu.Health > 0 then n = n + 1 end
			end
		end
		return n
	end
	sweepKill = function(range, useTP)
		if not isMurder() then return 0 end
		local _, myHRP, hum = getChar()
		if not (myHRP and hum) then return 0 end
		local knife = findKnife()
		if not knife then return 0 end
		if knife.Parent ~= player.Character then
			pcall(function() hum:EquipTool(knife) end)
			task.wait(0.2)
			knife = findKnife()
			if not knife then return 0 end
		end
		local startCF = myHRP.CFrame
		local n = 0
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character then
				local hr = p.Character:FindFirstChild("HumanoidRootPart")
				local hu = p.Character:FindFirstChildOfClass("Humanoid")
				if hr and hu and hu.Health > 0 then
					if range >= 100000 or (hr.Position - myHRP.Position).Magnitude <= range then
						local ok = pcall(function()
							if useTP then
								tpKnifeKill(p.Character)
							else
								knifeHit(knife, p.Character)
							end
						end)
						if ok then n = n + 1 end
					end
				end
			end
		end
		if useTP and n > 0 then
			local _, hrpR = getChar()
			if hrpR then
				hrpR.CFrame = startCF
				hrpR.AssemblyLinearVelocity = Vector3.zero
				hrpR.AssemblyAngularVelocity = Vector3.zero
			end
		end
		return n
	end

	task.spawn(function()
		while task.wait(0.5) do
			pcall(function()
				local rk = mm2RoleKey(player)
				local md = isMurder()
				lRole.Text = "Role: " .. (rk and string.upper(rk) or (md and "MURDER (knife)" or "?"))
				lRole.TextColor3 = md and MM2_COL_MURD or T.Dim
				lKnife.Text = "Knife: " .. (findKnife() and "OK" or "missing")
				lTgt.Text = "In range: " .. tostring(KAInRange)
			end)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(KADelay)
			if KAOn then
				pcall(function()
					if not isMurder() then KAInRange = 0 return end
					local _, myHRP, hum = getChar()
					if not (myHRP and hum) then KAInRange = 0 return end
					local knife = findKnife()
					if not knife then KAInRange = 0 return end
					if knife.Parent ~= player.Character then
						pcall(function() hum:EquipTool(knife) end)
						task.wait(0.2)
						knife = findKnife()
						if not knife then KAInRange = 0 return end
					end
					local n = 0
					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= player and p.Character then
							local hr = p.Character:FindFirstChild("HumanoidRootPart")
							local hu = p.Character:FindFirstChildOfClass("Humanoid")
							if hr and hu and hu.Health > 0 then
								if (hr.Position - myHRP.Position).Magnitude <= KARange then
									n = n + 1
									knifeHit(knife, p.Character)
								end
							end
						end
					end
					KAInRange = n
				end)
			else
				KAInRange = 0
			end
		end
	end)
end

