NotifyFn = function(txt)
	print("[KROMA] " .. tostring(txt))
	pcall(function()
		if ToastFrame and ToastLabel then
			toastToken = toastToken + 1
			local mine = toastToken
			ToastLabel.Text = tostring(txt)
			ToastFrame.Visible = true
			task.spawn(function()
				task.wait(2.5)
				if mine == toastToken then ToastFrame.Visible = false end
			end)
		end
	end)
end

