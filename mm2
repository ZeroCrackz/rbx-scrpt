local lastSafeCF = nil
track(RunService.Heartbeat:Connect(function()
	if CONFIG.AntiFling and not flinging and not flyEnabled then
		local _, hrp, hum = getChar()
		if hrp then
			local v = hrp.AssemblyLinearVelocity
			if v.Magnitude > 150 then hrp.AssemblyLinearVelocity = Vector3.zero hrp.AssemblyAngularVelocity = Vector3.zero end
			if lastSafeCF and v.Magnitude > 350 then
				hrp.CFrame = lastSafeCF
				hrp.AssemblyLinearVelocity = Vector3.zero
				if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
			end
			if hrp.AssemblyLinearVelocity.Magnitude < 60 then lastSafeCF = hrp.CFrame end
		end
	else lastSafeCF = nil end
end))

local function findPlayerByName(frag)
	frag = string.lower(frag)
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and (string.lower(p.Name) == frag or string.lower(p.DisplayName) == frag) then return p end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and (string.find(string.lower(p.Name), frag, 1, true) or string.find(string.lower(p.DisplayName), frag, 1, true)) then return p end
	end
	return nil
end
local function onChatCmd(msg)
	if type(msg) ~= "string" then return end
	local arg = string.match(string.lower(msg), "^%s*!tp%s+(.-)%s*$")
	if not arg or arg == "" then return end
	local t = findPlayerByName(arg)
	if t then
		local _, hrp = getChar()
		local tc = t.Character
		local th = tc and tc:FindFirstChild("HumanoidRootPart")
		if hrp and th then hrp.CFrame = th.CFrame * CFrame.new(2.5, 1, 2.5) hrp.AssemblyLinearVelocity = Vector3.zero end
	end
end
