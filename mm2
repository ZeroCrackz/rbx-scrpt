local function getPlayerRole(plr)
	if not plr then return nil end
	local ok, res = pcall(function()
		local r = plr:GetAttribute("Role") or plr:GetAttribute("Team") or plr:GetAttribute("Class")
		if r then return tostring(r) end
		local ch = plr.Character
		if ch then
			if ch:FindFirstChild("Knife") or ch:FindFirstChild("Blade") then return "Murder" end
			if ch:FindFirstChild("Gun") or ch:FindFirstChild("Revolver") then return "Sheriff" end
			local bp = plr:FindFirstChild("Backpack")
			if bp then
				if bp:FindFirstChild("Knife") or bp:FindFirstChild("Blade") then return "Murder" end
				if bp:FindFirstChild("Gun") or bp:FindFirstChild("Revolver") then return "Sheriff" end
			end
		end
		return nil
	end)
	if ok and res and res ~= "" then return tostring(res) end
	return nil
end
local roleCache = {}
local function getCachedRole(plr)
	local e = roleCache[plr]
	if e and tick() - e.time < 2 then return e.role end
	local r = getPlayerRole(plr)
	roleCache[plr] = { role = r, time = tick() }
	return r
end
track(Players.PlayerRemoving:Connect(function(p) roleCache[p] = nil end))
local function mm2RoleKey(plr)
	local r = getCachedRole(plr)
	if not r then return nil end
	r = string.lower(tostring(r))
	if string.find(r, "murder", 1, true) or string.find(r, "killer", 1, true) then return "murder" end
	if string.find(r, "sher", 1, true) or string.find(r, "gun", 1, true) or string.find(r, "detective", 1, true) then return "sheriff" end
	if string.find(r, "inno", 1, true) then return "innocent" end
	return nil
end
local function mm2ColorFor(plr)
	if not CONFIG.MM2 then return nil end
	local k = mm2RoleKey(plr)
	if k == "murder" then return MM2_COL_MURD
	elseif k == "sheriff" then return MM2_COL_SHER end
	return MM2_COL_INNO
end
local function mm2Tag(plr)
	if not CONFIG.MM2 then return "" end
	local k = mm2RoleKey(plr)
	if k == "murder" then return " [MURDER]"
	elseif k == "sheriff" then return " [SHERIFF]" end
	return " [INNO]"
end
local function getChar()
	local c = player.Character
	if not c then return nil, nil, nil end
	return c, c:FindFirstChild("HumanoidRootPart"), c:FindFirstChildOfClass("Humanoid")
end

