local function pressFX(b)
	local okB, already = pcall(function() return b:GetAttribute("KromaFX") end)
	if okB and already then return end
	pcall(function() b:SetAttribute("KromaFX", true) end)
	local saved, pressed = nil, false
	b.MouseButton1Down:Connect(function()
		pressed = true
		saved = b.BackgroundColor3
		pcall(function()
			TweenService:Create(b, TweenInfo.new(0.07), { BackgroundColor3 = Color3.new(
				math.clamp(saved.R * 0.55, 0, 1),
				math.clamp(saved.G * 0.55, 0, 1),
				math.clamp(saved.B * 0.55, 0, 1)) }):Play()
		end)
	end)
	local function release()
		if not pressed then return end
		pressed = false
		if saved then
			local c = saved
			pcall(function()
				TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = c }):Play()
			end)
		end
	end
	b.MouseButton1Up:Connect(release)
	b.MouseLeave:Connect(release)
end

