	pl.SortOrder = Enum.SortOrder.LayoutOrder
	local function close() pop.Visible = false end
	b.MouseButton1Click:Connect(function() pop.Visible = not pop.Visible end)
	for i, v in ipairs(values) do
		local ob = Instance.new("TextButton")
		ob.Size = UDim2.new(1, 0, 0, 24)
		ob.BackgroundColor3 = (v == cur) and Color3.fromRGB(35, 35, 38) or T.Panel
		ob.Font = Enum.Font.GothamMedium
		ob.TextSize = 12
		ob.TextColor3 = T.Txt
		ob.Text = "  " .. tostring(v)
		ob.TextXAlignment = Enum.TextXAlignment.Left
		ob.LayoutOrder = i
		ob.ZIndex = 51
		ob.Parent = pop
		corner(ob, 3)
		ob.MouseButton1Click:Connect(function()
			cur = v
			b.Text = "  " .. tostring(cur) .. "   ▼"
			close()
			if cb then cb(v) end
		end)
	end
	return { Set = function(v) cur = v b.Text = "  " .. tostring(cur) .. "   ▼" if cb then cb(v) end end, Close = close }
