FlingPlayerFn = function(targetPlr)
	if flinging then return end
	if not targetPlr or not targetPlr.Parent then return end
	local _, hrp, hum = getChar()
	local tch = targetPlr.Character
	local thrp = tch and tch:FindFirstChild("HumanoidRootPart")
	if not (hrp and hum and thrp) then NotifyFn("Fling failed") return end
	flinging = true
	local oldCF = hrp.CFrame
	if flyEnabled and FlySet then FlySet.Set(false) flyEnabled = false end
	task.spawn(function()
		local t0 = tick()
		local ang = 0
		while tick() - t0 < 2.5 do
			local _, myHRP = getChar()
			local tc = targetPlr.Character
			local tHRP = tc and tc:FindFirstChild("HumanoidRootPart")
			if not (myHRP and tHRP) then break end
			ang = ang + math.rad(55)
			pcall(function()
				myHRP.CFrame = tHRP.CFrame * CFrame.new(math.cos(ang) * 1.6, 0.5, math.sin(ang) * 1.6) * CFrame.Angles(0, ang * 5, 0)
				myHRP.AssemblyLinearVelocity = Vector3.new(math.random(-12000, 12000), 12000, math.random(-12000, 12000))
				myHRP.AssemblyAngularVelocity = Vector3.new(15000, 15000, 15000)
			end)
			RunService.Heartbeat:Wait()
		end
		pcall(function()
			local _, myHRP2 = getChar()
			local tc2 = targetPlr.Character
			local tHRP2 = tc2 and tc2:FindFirstChild("HumanoidRootPart")
			if myHRP2 and tHRP2 then
				local t1 = tick()
				while tick() - t1 < 0.35 do
					myHRP2.CFrame = tHRP2.CFrame * CFrame.new(0, -1.2, 0)
					myHRP2.AssemblyLinearVelocity = Vector3.new(0, 16000, 0)
					RunService.Heartbeat:Wait()
				end
				myHRP2.CFrame = oldCF
				myHRP2.AssemblyLinearVelocity = Vector3.zero
				myHRP2.AssemblyAngularVelocity = Vector3.zero
			end
		end)
		flinging = false
	end)
end
