track(RunService.RenderStepped:Connect(function()
	local col = espColorNow()
	local cam = workspace.CurrentCamera
	if not cam then KromaESPCount = 0 return end
	local _, myHRP = getChar()
	local myPos = myHRP and myHRP.Position or nil
	local vs = cam.ViewportSize
	local sx, sy = vs.X / 2, vs.Y - 6
	if CONFIG.TracerFrom == "Center" then sx, sy = vs.X / 2, vs.Y / 2
	elseif CONFIG.TracerFrom == "Mouse" then local m = UIS:GetMouseLocation() sx, sy = m.X, m.Y end
	local visible = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local o = getESP(plr)
			o.st.Thickness = CONFIG.ESPThickness
			local ch = plr.Character
			local P = espParts(plr, ch)
			local hd, hr, hu = P.Head, P.HRP, P.Hum
			local show = false
			local dist = 0
			if CONFIG.ESPEnabled and ch and hd and hr and hu and (hu.Health > 0 or CONFIG.ESPDead) and myPos then
				show = true
				dist = (hr.Position - myPos).Magnitude
				if dist > CONFIG.ESPMaxDist then show = false end
			end
			if not show then
				hideESP(o)
				local chm = chamsCache[plr]
				if chm then chm.Enabled = false end
			else
				local pcol = col
				if CONFIG.MM2 then pcol = mm2ColorFor(plr) or col end
				do
					local chm = chamsCache[plr]
					if not chm then
						chm = Instance.new("Highlight")
						chm.Name = "KromaChams"
						chm.FillTransparency = 0.5
						chm.OutlineTransparency = 0
						chm.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						chm.Parent = overlay
						chamsCache[plr] = chm
					end
					if CONFIG.CHAMS and ch then
						chm.Adornee = ch
						chm.FillColor = pcol
						chm.OutlineColor = pcol
						chm.Enabled = true
					else
						chm.Enabled = false
					end
				end
				local hp, oh = cam:WorldToViewportPoint(hd.Position + Vector3.new(0, 0.6, 0))
				local lp, ol = cam:WorldToViewportPoint(hr.Position - Vector3.new(0, 3, 0))
				local rp, ro = cam:WorldToViewportPoint(hr.Position)
				local cx, cy = vs.X / 2, vs.Y / 2
				local behind = false
				pcall(function() behind = cam.CFrame.LookVector:Dot((hr.Position - cam.CFrame.Position).Unit) < 0 end)
				if (not ro) or behind then
					o.box.Visible = false o.name.Visible = false o.tracer.Visible = false
					for _, f in ipairs(o.skel) do f.Visible = false end
					if CONFIG.ESPArrows then
						local dx, dy = rp.X - cx, rp.Y - cy
						if behind then dx = -dx dy = -dy end
						if math.abs(dx) < 1 and math.abs(dy) < 1 then dy = -1 end
						local a = math.atan2(dy, dx)
						local r = math.min(vs.X, vs.Y) * 0.36
						o.arrow.Visible = true o.arrow.TextColor3 = pcol
						o.arrow.Position = UDim2.new(0, math.clamp(cx + math.cos(a) * r, 30, vs.X - 30), 0, math.clamp(cy + math.sin(a) * r, 40, vs.Y - 40))
						o.arrow.Rotation = math.deg(a)
					else o.arrow.Visible = false end
				elseif (not oh) or (not ol) then
					hideESP(o)
				else
					visible = visible + 1
					o.arrow.Visible = false
					local hgt = math.clamp(math.abs(lp.Y - hp.Y), 10, 800)
					local wdt = math.clamp(hgt * 0.6, 8, 500)
					if CONFIG.ESPBox then
						o.box.Visible = true
						o.box.Size = UDim2.new(0, wdt, 0, hgt)
						o.box.Position = UDim2.new(0, hp.X - wdt / 2, 0, hp.Y)
						o.st.Color = pcol
					else o.box.Visible = false end
					if CONFIG.ESPName then
						o.name.Visible = true
						o.name.Text = plr.Name .. mm2Tag(plr) .. " [" .. math.floor(dist) .. "]"
						o.name.TextColor3 = pcol
						o.name.Size = UDim2.new(0, 200, 0, 16)
						o.name.Position = UDim2.new(0, hp.X - 100, 0, hp.Y - 18)
					else o.name.Visible = false end
					if CONFIG.ESPTracer then dline(o.tracer, sx, sy, hp.X, hp.Y, pcol) else o.tracer.Visible = false end
					if CONFIG.ESPSkeleton then
						for i, pair in ipairs(SKEL) do
							local f = o.skel[i]
							local a = P[pair[1]]
							local b = P[pair[2]]
							if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
								local pa, oa = cam:WorldToViewportPoint(a.Position)
								local pb, ob = cam:WorldToViewportPoint(b.Position)
								if oa and ob then dline(f, pa.X, pa.Y, pb.X, pb.Y, pcol) else f.Visible = false end
							else f.Visible = false end
						end
					else for _, f in ipairs(o.skel) do f.Visible = false end end
				end
			end
		end
	end
	KromaESPCount = visible
end))

